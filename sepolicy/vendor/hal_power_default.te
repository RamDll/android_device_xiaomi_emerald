# To do powerhint on nodes defined in powerhint.json
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default cgroup:dir search;
allow hal_power_default cgroup:file rw_file_perms;
allow hal_power_default proc_cpufreq:dir search;
allow hal_power_default proc_cpufreq:file rw_file_perms;
allow hal_power_default sysfs_gpu:file rw_file_perms;
allow hal_power_default sysfs_gpu:dir search;
allow hal_power_default sysfs_ged:dir search;
allow hal_power_default sysfs_ged:file rw_file_perms;
allow hal_power_default vendor_sysfs_thermalconfig:file rw_file_perms;
allow hal_power_default sysfs_therm:dir search;

# Touchfeature (xiaomi-touch)
allow hal_power_default touchfeature_device:chr_file rw_file_perms;

# To get/set powerhal state property
set_prop(hal_power_default, vendor_power_prop)

dontaudit hal_power_default self:capability dac_override;

# Double tap to wake: gesture mode is toggled through the touch input device
allow hal_power_default input_device:dir r_dir_perms;
allow hal_power_default input_device:chr_file rw_file_perms;

# Restore the backlight level after a panel ESD recovery (power-mode.cpp)
allow hal_power_default vendor_displayfeature_device:chr_file rw_file_perms;
allow hal_power_default sysfs_leds:dir search;
allow hal_power_default sysfs_leds:file rw_file_perms;

# ADPF: set uclamp/scheduling on the threads of hint session owners (as on Pixel)
# (apps run with per-user MLS categories, so the power HAL must be MLS-trusted to reach them)
typeattribute hal_power_default mlstrustedsubject;
allow hal_power_default self:capability sys_nice;
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default system_server:process setsched;
allow hal_power_default proc_stat:file r_file_perms;
