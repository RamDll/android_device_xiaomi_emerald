type vendor_dispreset, domain;
type vendor_dispreset_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_dispreset)

allow vendor_dispreset gpu_device:dir search;
allow vendor_dispreset dri_device:chr_file rw_file_perms;
set_prop(vendor_dispreset, vendor_dispreset_prop)
# Black dumb framebuffer for the modeset, if the driver wants a plane
allow vendor_dispreset dri_device:chr_file map;

# init mirrors the result to debug.dispreset.result, which the shell can read
get_prop(vendor_init, vendor_dispreset_prop)
