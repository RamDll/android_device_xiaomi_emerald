;;
;; emerald runs the stock OS3.0.305.0 vendor, whose policy is version 202504 and refers to the
;; system_ext public types (sepolicy_vndr, lineage sepolicy, ...) through <type>_202504 attributes,
;; e.g. "allow mtk_hal_audio sysfs_headset_202504". On LineageOS 24.0 (platform 202604) nothing ships
;; a system_ext compat/202504 map, so system_ext/etc/selinux/mapping/202504.cil was empty and all of
;; those vendor rules were dead (518 allow rules: the audio HAL could not read the headset jack state,
;; kpoc_charger, thermald, magt, mtd_device, ...). se_cil_compat_map installs the cat of every
;; system_ext private compat/202504/202504.cil as that file.
;;
;; Content: the build's own system_ext 202604 mapping with the version renamed (the system_ext public
;; types did not change between the stock 202504 policy and ours). Same layout as stock HyperOS
;; system_ext/etc/selinux/mapping/202504.cil. Tested on clean-2.0 2026-10-16: secilc with init's inputs
;; OK, live policy +518 allows, wired headphones work. check_clean1.sh compiles the policy offline.
(typeattributeset apmsrv_app_202504 (apmsrv_app))
(expandtypeattribute (apmsrv_app_202504) true)
(typeattribute apmsrv_app_202504)
(typeattributeset sysfs_headset_202504 (sysfs_headset))
(expandtypeattribute (sysfs_headset_202504) true)
(typeattribute sysfs_headset_202504)
(typeattributeset system_mtk_heavy_loading_prop_202504 (system_mtk_heavy_loading_prop))
(expandtypeattribute (system_mtk_heavy_loading_prop_202504) true)
(typeattribute system_mtk_heavy_loading_prop_202504)
(typeattributeset mdlogger_202504 (mdlogger))
(expandtypeattribute (mdlogger_202504) true)
(typeattribute mdlogger_202504)
