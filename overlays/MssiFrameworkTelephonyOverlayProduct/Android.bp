// Copy of hardware/mediatek overlay/MssiFrameworkTelephonyOverlay (LineageOS hardware/mediatek 68f9be7), which is
// vendor: true and so never reaches the phone: clean-1 ships the stock vendor.img. Without it
// clean-1.1 had no MMTEL ImsService and no VoLTE toggle (2026-10-14).
runtime_resource_overlay {
    name: "MssiFrameworkTelephonyOverlayProduct",
    product_specific: true,
}
