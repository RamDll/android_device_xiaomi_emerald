<resources>
    <!-- LineageOS max / min refresh rate lists in Settings > Display (120 / 90 / 60 Hz, the panel's
         modes). Tested on clean-2.7 through fabricated overlays (2026-10-20): both lists shown,
         max 60 Hz keeps the screen at 60 Hz while scrolling. -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <bool name="config_show_min_refresh_rate_switch">true</bool>

    <!-- Fingerprint enroll ring around the under-display sensor: AOSP's 280 draws a ring far wider
         than the sensor; 90 as on the old rebuild-1 tree. Tested on clean-2.12 through a /data RRO
         (2026-10-28): the ring hugs the sensor icon. -->
    <integer name="config_udfpsEnrollProgressBar">90</integer>
</resources>
