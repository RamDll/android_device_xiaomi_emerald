<resources>
    <!-- The stock fingerprint HAL lights the sensor itself (local HBM, see udfps/UdfpsApp.java).
         With this SystemUI's UdfpsController skips udfpsView.configureDisplay() (its own
         illumination surface + refresh rate vote) and sends onUiReady at once. On clean-1.1 that
         surface was created and destroyed on every touch. Same value as the old tree. -->
    <bool name="config_ignoreUdfpsVote">true</bool>
    <!-- Display geometry, values as the stock OS3.0.305.0 product overlay DevicesAndroidOverlay.apk (HyperOS ships
         them in product, which clean-1/clean-2 replace with our own). Without them LineageOS assumes no cutout and
         square corners: the status bar clock sat at the left edge (2026-10-15). Front camera cutout, in px from the
         top centre: -->
    <string translatable="false" name="config_mainBuiltInDisplayCutout">M 0,0 H -28 V 111 H 28 V 0 H 0 Z</string>
    <string translatable="false" name="config_mainDisplayShape">M20 0h1040s20 0 20 20v2360s0 20 -20 20h-1040s-20 0 -20 -20v-2360s0 -20 20 -20</string>
    <!-- The stock MTK vendor overlay (com.mediatek.frameworkresoverlay) points the doze component at
         com.android.dreams.alwaysondisplay, a HyperOS app we don't ship: DreamValidator rejected it at every screen off,
         so there was no doze and no notification pulse (2026-10-18). -->
    <string translatable="false" name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <!-- AOSP default 0.0 = backlight 1/2047, a black pulse; the stock displayconfig has no doze brightness either.
         SystemUI clamps it to the current user/auto brightness. Tested on 2.1 by bind mount: visible, not too dim. -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.06</item>
    <!-- With auto-brightness on, the notification pulse uses the current auto-brightness instead of the fixed doze
         value above (that one stays for manual brightness). The light sensor runs only while the pulse is on, not with
         the screen off in doze. Tested on 2.2 by bind mount (2026-10-18). -->
    <bool name="config_allowAutoBrightnessWhileDozing">true</bool>
    <!-- Brightness range for configs/displayconfig/display_port_0.xml (lights HAL scale). A17 DisplayDeviceConfig
         rejects the map (system_server crash) unless the setting minimum is >= its first backlight point; the stock
         MTK vendor overlay sets 0.0. Minimum and dim = 1/254 = backlight level 9 (level 1 was black at the slider
         minimum, tester 2026-10-15); default 0.15 = ~75 nits as stock (307 of 4095). Tested on clean-2.1 by bind
         mount (2026-10-18): slider minimum level 9 also with auto-brightness, maximum 2047. -->
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.003937008</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.15</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.003937008</item>
</resources>
