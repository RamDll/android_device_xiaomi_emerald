    <!-- "Tap to wake" in Settings. EmeraldUdfps and emerald_dt2w switch the touch panel's gesture
         (udfps/DoubleTapToWake.java, touch/dt2w.cpp): the stock power HAL doesn't drive the touch panel.
         Tested by hand on 2.3 (2026-10-18). -->
    <bool name="config_supportDoubleTapWake">true</bool>
    <!-- "Lift to check phone" in Settings, and screen-off fingerprint unlock on by default as on HyperOS and the old
         tree. EmeraldUdfps shows the ambient screen for both (udfps/ScreenOffPulse.java, udfps/KeyHandler.java):
         SystemUI's doze sensors take one-shot sensors only. Tested by hand on 2.3 (2026-10-18). -->
    <bool name="config_dozePulsePickup">true</bool>
    <bool name="config_screen_off_udfps_default_on">true</bool>
    <!-- Shows the screen-off unlock switch in Settings (FingerprintSettings.isScreenOffUnlcokSupported). It changes
         nothing else here: without config_dozeUdfpsLongPressSensorType SystemUI's screen-off udfps paths stay off. -->
    <bool name="config_screen_off_udfps_enabled">true</bool>
