<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.emerald.udfps">

    <!-- registerBiometricStateListener() reads the user list (UserManager.getAliveUsers) with the
         caller's identity, so it needs MANAGE_USERS as well. Without it the app crashed on start,
         and as a persistent app it crash-looped into a RescueParty reboot (clean-1.2, 2026-10-15). -->
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC_INTERNAL" />

    <application
        android:name=".UdfpsApp"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:label="Emerald UDFPS"
        android:persistent="true" />
</manifest>
