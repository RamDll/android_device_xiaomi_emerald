# Not started at boot any more: the modeset before the composer fixed the panel timing but left the
# boot animation and the first screen black (r27.1). XiaomiParts now does one screen off/on at
# LOCKED_BOOT_COMPLETED instead. Kept for manual experiments: `start vendor.dispreset` from a root
# shell, before the composer, with persist.log.tag.emerald_no_dispreset unset.
service vendor.dispreset /vendor/bin/dispreset
    user system
    group graphics
    oneshot
    disabled

# The shell can't read vendor properties; debug.* it can.
on property:vendor.dispreset.result=*
    setprop debug.dispreset.result ${vendor.dispreset.result}
