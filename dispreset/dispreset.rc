# Power-cycle the panel once, before the composer takes over the display that LK left on.
# Persistent properties (the persist.log.tag.emerald_no_dispreset switch) are loaded by then,
# and surfaceflinger only starts on boot.
service vendor.dispreset /vendor/bin/dispreset
    user system
    group graphics
    oneshot
    disabled

on load_persist_props_action
    exec_start vendor.dispreset

# The shell can't read vendor properties; debug.* it can.
on property:vendor.dispreset.result=*
    setprop debug.dispreset.result ${vendor.dispreset.result}
