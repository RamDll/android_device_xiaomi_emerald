// IHalAdapterVendorExtension for the stock MediaTek AIDL audio HAL: AOSP's
// frameworks/av/services/audioparameterparser example, with parseVendorParameters() passing
// module parameters through (see ParameterParser.cpp). Stock HyperOS ships the same service
// (system_ext, "Audio_DecoupledMtk") with ro.audio.ihaladaptervendorextension_enabled=true.
cc_binary {
    name: "android.hardware.audio.parameter_parser.service",
    system_ext_specific: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.audio.parameter_parser.service.rc"],
    defaults: [
        "latest_android_hardware_audio_core_ndk_shared",
    ],
    srcs: [
        "ParameterParser.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "av-audio-types-aidl-ndk",
        "libbase",
        "libbinder_ndk",
        "libmedia_helper",
        "libmediautils",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wthread-safety",
    ],
}
