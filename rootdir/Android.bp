// The stock fstab of 305 (vendor_boot first_stage_ramdisk/fstab.mt6789 == vendor/etc/fstab.mt6789)
// with sysfs_path on /data. Installed to the vendor ramdisk only: vendor.img is the stock image and
// patch-images.py puts the same file over its copy.
prebuilt_etc {
    name: "fstab.mt6789",
    src: "etc/fstab.mt6789",
    vendor_ramdisk: true,
}

prebuilt_etc {
    name: "emerald_noconsole.rc",
    src: "etc/init/emerald_noconsole.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "emerald_tuning.rc",
    src: "etc/init/emerald_tuning.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
