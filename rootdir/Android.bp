// Stock fstab (vendor_boot first_stage_ramdisk/fstab.mt6789 == vendor/etc/fstab.mt6789 of 305).
// Installed to the vendor ramdisk only: vendor.img is the stock image and has its own copy.
prebuilt_etc {
    name: "fstab.mt6789",
    src: "etc/fstab.mt6789",
    vendor_ramdisk: true,
}

prebuilt_etc {
    name: "emerald_noconsole.rc",
    src: "etc/init/emerald_noconsole.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
